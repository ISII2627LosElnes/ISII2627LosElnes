@startuml
class ResenaItem {
    + ResenaItem()
    + ResenaItem(libro:Libro, descripcion:string?, calificacion:int, resena:Resena)
    + Descripcion : string? <<get>> <<set>>
    + Calificacion : int <<get>> <<set>>
    + LibroId : int <<get>> <<set>>
    + Libro : Libro <<get>> <<set>>
    + ResenaId : int <<get>> <<set>>
    + Resena : Resena <<get>> <<set>>
}
@enduml
