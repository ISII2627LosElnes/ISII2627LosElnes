@* 1. DIRECTIVAS *@
@page "/reposiciones/selectreposiciones"
@rendermode InteractiveServer
@using AppForSEII.Web.API
@inject AppForSEIIAPIClient apiservice
@inject ReposicionStateContainer reposicionState
@inject NavigationManager navigation
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]

<PageTitle>Reponer Libros</PageTitle>

@* 2. MARKUP HTML CON BOOTSTRAP Y RAZOR *@
<div class="container">
    @* Cabecera *@
    <h3>Seleccionar libros para reponer</h3>

    @* Filtros (Autor y Género) *@
    <div class="row mb-3">
        <div class="col-md-4">
            <input type="text" class="form-control" placeholder="Filtrar por autor..." @bind="filtroAutor" id="inputAutor" />
        </div>
        <div class="col-md-4">
            <input type="text" class="form-control" placeholder="Filtrar por género..." @bind="filtroGenero" id="inputGenero" />
        </div>
        <div class="col-md-4">
            <button class="btn btn-primary" @onclick="SearchLibros" id="searchLibros">Buscar</button>
        </div>
    </div>

    @* Aviso de error si falla la API *@
    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger">@errorMessage</div>
    }

    @* Resultados y Carrito *@
    <div class="row">
        <div class="col-md-8">
            @if (libros == null)
            {
                <p>Cargando libros...</p>
            }
            else if (!libros.Any())
            {
                <p>No hay libros disponibles para reponer con esos filtros.</p>
            }
            else
            {
                <table class="table table-striped table-hover" id="TableOfLibros">
                    <thead>
                        <tr>
                            <th>Título</th>
                            <th>Autor</th>
                            <th>Género</th>
                            <th>Fecha Lanzamiento</th>
                            <th>Precio Reposición</th>
                            <th>Acción</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var libro in libros)
                        {
                            <tr>
                                <td>@libro.Titulo</td>
                                <td>@libro.Autor</td>
                                <td>@libro.Genero</td>
                                <td>@libro.FechaLanzamiento.DateTime.ToShortDateString()</td>
                                <td>@libro.PrecioReposicion €</td>
                                <td>
                                    <button class="btn btn-outline-primary btn-sm"
                                            @onclick="@(() => AddLibro(libro))"
                                            id="libroToReponer_@libro.Titulo">
                                        Añadir
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>

        <div class="col-md-4">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Carrito de reposición</h5>

                    @if (!reposicion.ReposicionItems.Any())
                    {
                        <p class="text-muted">No hay libros seleccionados.</p>
                    }
                    else
                    {
                        @foreach (var item in reposicion.ReposicionItems)
                        {
                            var subtotal = reposicionState.GetPrecioUnitario(item.Titulo) * item.Cantidad;
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <div>
                                    <strong>@item.Titulo</strong>
                                    <span class="badge bg-secondary ms-1">x@item.Cantidad</span>
                                    <div class="text-muted small">@subtotal.ToString("0.00") €</div>
                                </div>
                                <div class="d-flex gap-1">
                                    <button class="btn btn-outline-secondary btn-sm"
                                            @onclick="@(() => DecreaseLibro(item))"
                                            title="Restar uno">
                                        -
                                    </button>
                                    <button class="btn btn-outline-danger btn-sm"
                                            @onclick="@(() => RemoveItem(item))"
                                            id="removeLibro_@item.Titulo">
                                        Eliminar
                                    </button>
                                </div>
                            </div>
                        }
                    }

                    <hr />
                    <h5>Precio total: @reposicionState.PrecioTotal.ToString("0.00") €</h5>

                    <button class="btn btn-primary w-100 mt-2"
                            @onclick="ReponerLibros"
                            disabled="@(!reposicion.ReposicionItems.Any())"
                            id="reponerLibrosButton">
                        Reponer libros
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@* 3. LÓGICA C# *@
@code {
    private ICollection<LibroParaReponerDTO>? libros;
    private string? filtroAutor;
    private string? filtroGenero;
    private string errorMessage = "";

    private ReposicionForCreateDTO reposicion => reposicionState.Reposicion;

    // Se ejecuta automáticamente al cargar la página
    protected override async Task OnInitializedAsync()
    {
        await SearchLibros();
    }

    private async Task SearchLibros()
    {
        errorMessage = "";
        try
        {
            string? autor = string.IsNullOrWhiteSpace(filtroAutor) ? null : filtroAutor;
            string? genero = string.IsNullOrWhiteSpace(filtroGenero) ? null : filtroGenero;

            libros = await apiservice.GetLibrosParaReponerAsync(autor, genero);
        }
        catch (ApiException)
        {
            errorMessage = "Error al conectar con la API para cargar los libros.";
            libros = new List<LibroParaReponerDTO>();
        }
        StateHasChanged();
    }

    private void AddLibro(LibroParaReponerDTO libro)
    {
        reposicionState.AddLibroToReposicion(libro);
    }

    private void DecreaseLibro(ReposicionItemDTO item)
    {
        reposicionState.DecreaseLibroQuantity(item);
    }

    private void RemoveItem(ReposicionItemDTO item)
    {
        reposicionState.RemoveReposicionItem(item);
    }

    private void ReponerLibros()
    {
        navigation.NavigateTo("/reposiciones/createreposicion");
    }
}