@page "/reposiciones/detailreposicion"
@rendermode InteractiveServer
@using AppForSEII.Web.API
@using Microsoft.AspNetCore.Authorization
@inject AppForSEIIAPIClient apiservice


@attribute [Authorize]

<PageTitle>Detalle de Reposición</PageTitle>

<h3>Detalle de Reposición</h3>

@if (reposicion == null)
{
    <p>@error</p>
}
else
{
    <table class="table table-borderless table-sm">
        <tr>
            <th>Nombre y Apellidos</th>
            <td id="NameSurname">@reposicion.Nombre @reposicion.Apellido</td>
        </tr>
        <tr>
            <th>Teléfono</th>
            <td id="Telefono">@reposicion.Telefono</td>
        </tr>
        <tr>
            <th>Método de Pago</th>
            <td id="MetodoPago">@reposicion.MetodoPago</td>
        </tr>
        <tr>
            <th>Fecha de Reposición</th>
            <td id="FechaReposicion">@reposicion.FechaReposicion.DateTime.ToString("dd/MM/yyyy HH:mm:ss")</td>
        </tr>
    </table>

    <h4>Libros Repuestos</h4>

    <table class="table table-striped table-hover" id="LibrosRepuestos">
        <thead>
            <tr>
                <th scope="col">Título</th>
                <th scope="col">Autor</th>
                <th scope="col">Cantidad</th>
            </tr>
        </thead>
        <tbody>
            @foreach (ReposicionItemDTO item in reposicion.ReposicionItems)
            {
                <tr id="ReposicionItem_@item.Titulo">
                    <td>@item.Titulo</td>
                    <td>@item.Autor</td>
                    <td>@item.Cantidad</td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr>
                @* colspan agrupa las 2 primeras columnas para alinear el total bajo la última *@
                <th scope="row" colspan="2" class="text-end">Precio Total</th>
                <td id="PrecioTotal">@reposicion.PrecioTotal.ToString("0.00") €</td>
            </tr>
        </tfoot>
    </table>
}

@code {
    [Parameter]
    [SupplyParameterFromQuery]
    public int ReposicionID { get; set; }

    private ReposicionDetailDTO? reposicion;
    private string error = "";

    [CascadingParameter]
    private Task<AuthenticationState>? authenticationState { get; set; }

    protected override async Task OnInitializedAsync()
    {
        // Comprobación del usuario autenticado (igual que en el ejemplo)
        string userName = "";
        if (authenticationState is not null)
        {
            var authState = await authenticationState;
            var user = authState?.User;

            if (user is not null)
            {
                if (user.Identity is not null && user.Identity.IsAuthenticated && user.IsInRole("Admin"))
                {
                    userName = user.Identity.Name ?? "";
                }
            }
        }

        try
        {
            reposicion = await apiservice.GetDetailsForReposicionesAsync(ReposicionID);
        }
        catch (ApiException)
        {
            reposicion = null;
        }

        if (reposicion == null)
        {
            error = $"¡Error! No estás autorizado para ver esta reposición o no existe ninguna reposición con id={ReposicionID}.";
        }
    }
}