@page "/subastas/seleccionarlibrosparasubastar"
@using AppForSEII.Web.API
@using Microsoft.AspNetCore.Authorization
@inject ILogger<SeleccionarLibrosParaSubastar> logger
@inject AppForSEIIAPIClient apiservice
@inject SubastaStateContainer subastaState
@inject NavigationManager navigation
@attribute [Authorize]

<div class="container-fluid mt-3">
    <h2 class="mb-4">Seleccionar libros para subastar</h2>

    @* Mensajes de error *@
    @if (!string.IsNullOrEmpty(messageError))
    {
        <div class="alert alert-danger" role="alert" id="MessageError">
            @messageError
        </div>
    }

    @* Sección de Filtros: Título y Editorial (Flujo Alternativo 1) *@
    <div class="row g-3 align-items-center mb-4">
        <div class="col-md-4">
            <input type="text" class="form-control" @bind="libroTitulo" id="libroTitulo" placeholder="Filtrar por título..." />
        </div>
        <div class="col-md-4">
            <input type="text" class="form-control" @bind="libroEditorial" id="libroEditorial" placeholder="Filtrar por editorial..." />
        </div>
        <div class="col-auto">
            <button type="button" class="btn btn-primary px-4" id="buscarLibros" @onclick="@BuscarLibros">
                Buscar
            </button>
        </div>
    </div>

    @* Distribución en 2 columnas: Tabla a la izquierda (8) y Lista de pujas a la derecha (4) *@
    <div class="row g-4">
        <div class="col-md-8">
            @if (libros == null)
            {
                <p><em>Cargando libros...</em></p>
            }
            else if (libros.Count == 0)
            {
                @* Flujo Alternativo 0 *@
                <div class="alert alert-warning" role="alert">
                    No hay libros disponibles para subastar con los criterios seleccionados.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover align-middle" id="TableOfLibros">
                        <thead>
                            <tr>
                                <th>Título</th>
                                <th>Editorial</th>
                                <th>Autor</th>
                                <th>Tipo de Libro</th>
                                <th>Acción</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var libro in libros)
                            {
                                bool yaAnadido = subastaState.EstaLibroSeleccionado(libro);

                                <tr id="LibroData_@libro.Titulo">
                                    <td>@libro.Titulo</td>
                                    <td>@libro.Editorial</td>
                                    <td>@libro.Autor</td>
                                    <td>@libro.TipoLibro</td>
                                    <td>
                                        <button type="button"
                                                class="btn btn-outline-primary"
                                                id="libroToSubastar_@libro.Titulo"
                                                disabled="@yaAnadido"
                                                @onclick="@(() => AnadirLibro(libro))">
                                            @(yaAnadido ? "Añadido" : "Añadir")
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

        @* Carrito lateral permanente (Paso 3, Paso 4 y Flujo Alternativo 3) *@
        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h4 class="card-title mb-3">Lista de pujas</h4>

                    @if (subastaState.librosSubasta.Count == 0)
                    {
                        <p class="text-muted">No hay libros seleccionados.</p>
                    }
                    else
                    {
                        @foreach (var libro in subastaState.librosSubasta)
                        {
                            <div class="d-flex justify-content-between align-items-center border-bottom py-2">
                                <div class="me-2">
                                    <div class="fw-bold">@libro.Titulo</div>
                                    <div class="text-muted small">@libro.Autor (@libro.Editorial)</div>
                                </div>
                                <button type="button"
                                        class="btn btn-outline-danger btn-sm"
                                        id="LibroSelected_@libro.Titulo"
                                        @onclick="@(() => EliminarLibro(libro))">
                                    Eliminar
                                </button>
                            </div>
                        }
                    }

                    <div class="mt-3 pt-2">
                        <h5 class="mb-3">Libros seleccionados: @subastaState.librosSubasta.Count</h5>
                        <button type="button"
                                class="btn btn-primary w-100 py-2"
                                id="Pujar"
                                @onclick="@IrACrearSubasta"
                                disabled="@pujarBotonDeshabilitado">
                            Pujar libros
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private ICollection<LibroParaSubastarDTO>? libros { get; set; } = new List<LibroParaSubastarDTO>();
    private string? libroTitulo;
    private string? libroEditorial;
    private string? messageError;

    // Flujo Alternativo 4: Deshabilitar botón si no hay libros seleccionados
    private bool pujarBotonDeshabilitado => subastaState.librosSubasta == null || subastaState.librosSubasta.Count == 0;

    private void AnadirLibro(LibroParaSubastarDTO libro)
    {
        subastaState.AnadirLibroSubasta(libro);
    }

    private void EliminarLibro(LibroParaSubastarDTO libro)
    {
        subastaState.EliminarLibro(libro);
    }

    protected override async Task OnInitializedAsync()
    {
        await BuscarLibros();
    }

    protected async Task BuscarLibros()
    {
        messageError = "";
        try
        {
            libros = await apiservice.GetLibrosParaSubastarAsync(libroTitulo, libroEditorial);
        }
        catch (ApiException ex)
        {
            libros = new List<LibroParaSubastarDTO>();
            messageError = "Error al obtener los libros disponibles para subasta.";
            logger.LogError(ex, "Error al conectar con el servicio de libros para subastar.");
        }
        catch (HttpRequestException ex)
        {
            libros = new List<LibroParaSubastarDTO>();
            messageError = "No se pudo conectar con la API. Comprueba que AppForSEII.API está ejecutándose.";
            logger.LogError(ex, "Error de conexión HTTP con la API.");
        }

        StateHasChanged();
    }

    private void IrACrearSubasta()
    {
        navigation.NavigateTo("/subastas/crearsubasta");
    }
}