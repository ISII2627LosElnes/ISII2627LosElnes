@* DIRECTIVAS *@

@page "/subastas/seleccionarlibrosparasubastar"
@using AppForSEII.Web.API
@using Microsoft.AspNetCore.Authorization
@inject ILogger<SeleccionarLibrosParaSubastar> logger
@inject AppForSEIIAPIClient apiservice
@inject SubastaStateContainer subastaState
@inject NavigationManager navigation
@attribute [Authorize]

<h3>Selecciona libros para subastar</h3>


@*Especificaciones con html*@

<div class="container-fluid">
    @* Mensajes de error (Flujo Alternativo 0) *@
    <div class="row">
        @if (!string.IsNullOrEmpty(messageError))
        {
            <div class="row alert alert-danger" role="alert" id="MessageError">
                @messageError
            </div>
        }

        @* Barra superior de estado del carrito y botón continuar (Paso 3 y 4) *@
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div><b>Libros seleccionados:</b> @subastaState.librosSubasta.Count</div>
            <div>
                <button class="btn btn-outline-primary" id="mostrarCarritoSubasta" @onclick="@AlternarCarritoSubasta">
                    Lista de pujas (@subastaState.librosSubasta.Count)
                </button>
            </div>
            <button class="btn btn-primary" id="Pujar" @onclick="@IrACrearSubasta" disabled="@pujarBotonDeshabilitado">
                Pujar
            </button>
        </div>
    </div>

    @* Sección de Filtros: Título y Editorial (Flujo Alternativo 1) *@
    <div class="row mb-4">
        <h5>Filtrar Libros</h5>
        <div class="input-group">
            <div class="input-group-prepend">
                <span class="input-group-text">Título</span>
            </div>
            @* el @bind guarda lo que escribe el usuario, en la variable dada (libroTitulo o LibroEditorial)*@
            <input type="text" class="form-control" @bind="libroTitulo" id="libroTitulo" placeholder="Buscar por título..." />

            <div class="input-group-prepend">
                <span class="input-group-text">Editorial</span>
            </div>
            <input type="text" class="form-control" @bind="libroEditorial" id="libroEditorial" placeholder="Buscar por editorial..." />
            @* Si tienes un endpoint GetEditorialesAsync, puedes sustituir el input anterior por un <select> como en el ejemplo de géneros *@

            <div class="input-group-append">
                <button class="btn btn-outline-primary" id="buscarLibros" @onclick="@BuscarLibros">
                    Buscar libros disponibles
                </button>
            </div>
        </div>
    </div>

    @* Tabla de resultados y Carrito lateral *@
    <div class="row">
        <div class="@(mostrarCarritoSubasta ? "col-md-8" : "col-md-12")">
            @if (libros == null)
            {
                <p><em>Cargando libros...</em></p>
            }
            else if (libros.Count == 0)
            {
                @* Flujo Alternativo 0 *@
                <div class="alert alert-warning" role="alert">
                    No hay libros disponibles para subastar con los criterios seleccionados.
                </div>
            }
            else
            {
                <div class="mh-100 table-responsive">
                    <table class="table table-condensed table-hover" id="TableOfLibros">
                        <thead>
                            <tr>
                                <th>Título</th>
                                <th>Editorial</th>
                                <th>Autor</th>
                                <th>Tipo de Libro</th>
                                <th>Seleccionar</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var libro in libros)
                            {
                                <tr id="LibroData_@libro.Titulo">
                                    <td>@libro.Titulo</td>
                                    <td>@libro.Editorial</td>
                                    <td>@libro.Autor</td>
                                    <td>@libro.TipoLibro</td>
                                    <td>
                                        <button class="btn btn-outline-secondary" 
                                                id="libroToSubastar_@libro.Titulo" 
                                                @onclick="@(() =>AnadirLibro(libro))"> Añadir
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

        @* Carrito de pujas para eliminar libros (Flujo Alternativo 3) *@
        @if (mostrarCarritoSubasta)
        {
            <div class="col-md-4">
                <div class="card">
                    <div class="card-body">
                        <h5 class="card-title">Libros para pujar</h5>
                        <div class="d-grid gap-2">
                            @*aquí se implementan los botones rojos que aparecen para eliminar cada libro*@
                            @foreach (var libro in subastaState.librosSubasta)
                            {
                                <button type="button" 
                                        class="btn btn-outline-danger text-start" 
                                        id="LibroSelected_@libro.Titulo" 
                                        @onclick="@(() => EliminarLibro(libro))">
                                        @libro.Titulo (@libro.Autor) @*leen y muestran el texto de eso*@
                                </button>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>


@*CÓDIGO EN C#, para implementar la lógica detras de los métodos usados*@
@code {
    // 1. Estado de la consulta y filtros (Ajusta el nombre del DTO si NSwag lo generó distinto)
    private ICollection<LibroParaSubastarDTO>? libros { get; set; } = new List<LibroParaSubastarDTO>();
    private string? libroTitulo;
    private string? libroEditorial;
    private string? messageError;

    // 2. Conexión con el StateContainer de Subastas
    //private SubastaForCreateDTO subasta => subastaState.Subasta;
    
    // Flujo Alternativo 4: Deshabilitar botón si no hay libros seleccionados
    private bool pujarBotonDeshabilitado => subastaState.librosSubasta == null || subastaState.librosSubasta.Count == 0;
    
    private bool mostrarCarritoSubasta = false;

//para mostrar u ocultar con un desplehable el carrito
    private void AlternarCarritoSubasta()
    {
        mostrarCarritoSubasta = !mostrarCarritoSubasta;
    }

    private void AnadirLibro(LibroParaSubastarDTO libro)
    {
        subastaState.AnadirLibroSubasta(libro);
        mostrarCarritoSubasta = true; // Muestra el carrito automáticamente al añadir
    }

    private void EliminarLibro(LibroParaSubastarDTO libro)
    {
        subastaState.EliminarLibro(libro);
    }

    protected override async Task OnInitializedAsync()
    {
        await BuscarLibros();
    }

    protected async Task BuscarLibros()
    {
        messageError = "";
        try
        {
            // Ajusta el nombre del método según tu IAppForSEIIAPIClient (ej. GetLibrosParaSubastarAsync)
            libros = await apiservice.GetLibrosParaSubastarAsync(libroTitulo, libroEditorial);
        }
        catch (ApiException ex)
        {
            libros = new List<LibroParaSubastarDTO>();
            messageError = "Error al obtener los libros disponibles para subasta.";
            logger.LogError(ex, "Error al conectar con el servicio de libros para subastar.");
        }

        StateHasChanged();
    }

    private void IrACrearSubasta()
    {
        // Navega al paso 5 del Caso de Uso (Formulario de datos y precios de puja)
        navigation.NavigateTo("/subastas/crearsubasta");
    }
}