@* directivas *@
@page "/resenas/listlibrospararesenar"
@using AppForSEII.Web.API
@using Microsoft.AspNetCore.Authorization


@inject AppForSEIIAPIClient apiservice
@inject ResenaStateContainer resenaState
@inject NavigationManager navigation

@attribute [Authorize]

@*HTML con las llamadas a C#*@

        @*cabecera*@
        <PageTitle>Reseñar libros</PageTitle>

        <h3>Seleccionar libros para reseñar</h3>

        <div class="container">

            @* filtros *@
            <div class="row mb-3">

                <div class="col-md-4">
                    <input type="text"
                        class="form-control"
                        placeholder="Filtrar por tipo de libro..."
                        @bind="tipoLibro" />
                </div>

                <div class="col-md-4">
                    <input type="text"
                        class="form-control"
                        placeholder="Filtrar por género..."
                        @bind="genero" />
                </div>

                <div class="col-md-4">
                    <button class="btn btn-primary"
                            @onclick="BuscarLibros">
                        Buscar
                    </button>
                </div>

            </div>
            @* resultados *@
            <div class="row mt-3">

                @*columna izquierda*@
                <div class="col-md-8">
                    @*comprobamos que se han cargado los libros *@
                    @if (libros != null)
                    {   
                        @*si la api devuelve lista vacia se muestra el mensaje*@
                        @if (!libros.Any())
                        {
                            <p>No se han encontrado libros.</p>
                        }
                        else
                        {
                            <table class="table table-striped table-hover">
                                <thead>
                                    <tr>
                                        <th>Título</th>
                                        <th>Tipo</th>
                                        <th>Género</th>
                                        <th>Editorial</th>
                                        <th>Autor</th>
                                        <th>Calificación</th>
                                        <th>Fecha</th>
                                        <th>Acción</th>
                                    </tr>
                                </thead>

                                <tbody>
                                    @foreach (var libro in libros)
                                    {
                                        <tr>
                                            <td>@libro.Titulo</td>
                                            <td>@libro.TipoLibro</td>
                                            <td>@libro.Genero</td>
                                            <td>@libro.Editorial</td>
                                            <td>@libro.Autor</td>
                                            <td>@libro.CalificacionMedia</td>
                                            <td>@libro.FechaLanzamiento.ToString("dd/MM/yyyy")</td>
                                            <td>
                                            @if (resenaState.LibrosSeleccionados.Any(l => l.Id == libro.Id))
                                            {
                                                <button class="btn btn-outline-primary" disabled>
                                                    Añadido
                                                </button>
                                            }
                                            else
                                            {
                                                <button class="btn btn-primary"
                                                        @onclick="() => AddLibro(libro)">
                                                    Añadir
                                                </button>
                                            }
                                        </td>
                                    </tr>
                                    }
                                </tbody>
                            </table>
                        }
                    }

                </div>



                @* columna derecha *@
                <div class="col-md-4">

                <div class="border rounded p-3">

                <h4>Libros seleccionados</h4>

                @if (resenaState.LibrosSeleccionados.Count == 0)
                {
                    <p>No has seleccionado ningún libro.</p>
                }
                else
                {
                    @foreach (var libro in resenaState.LibrosSeleccionados)
                    {
                        <div class="border-bottom py-3 d-flex justify-content-between align-items-center">
                            <strong>@libro.Titulo</strong>

                            <button class="btn btn-outline-danger"
                                @onclick="() => RemoveLibro(libro)">
                            Eliminar
                        </button>
                    </div>
                    }
                }

                <button class="btn btn-primary w-100 mt-3"
                        disabled="@(resenaState.LibrosSeleccionados.Count == 0)"
                        @onclick="HacerResena">
                    Hacer reseña
                </button>

</div>

            </div>

        </div>

    </div>


 @*logica en C#*@
@code {
    private string? tipoLibro;
    private string? genero;
    private ICollection<LibroParaResenarDTO>? libros;

    private async Task BuscarLibros()
    {
         libros = await apiservice.GetLibrosParaResenarAsync(tipoLibro, genero);
    }
    private void AddLibro(LibroParaResenarDTO libro)
    {
        resenaState.AddLibro(libro);
    }

    private void RemoveLibro(LibroParaResenarDTO libro)
    {
        resenaState.RemoveLibro(libro);
    }

    private void HacerResena()
{
    navigation.NavigateTo("/resenas/createresena");
}


protected override async Task OnInitializedAsync()
{
    libros = await apiservice.GetLibrosParaResenarAsync(null, null);
}
}