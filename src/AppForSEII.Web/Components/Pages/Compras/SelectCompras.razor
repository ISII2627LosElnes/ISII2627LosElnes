

@* 1. DIRECTIVAS *@
@page "/compras/selectcompras"
@attribute [ExcludeFromInteractiveRouting]
@rendermode InteractiveServer
@using AppForSEII.Web
@using AppForSEII.Web.API
@inject AppForSEIIAPIClient apiservice
@inject CompraStateContainer compraState
@inject NavigationManager navigation

@* Descomenta estas dos líneas cuando quieras exigir inicio de sesión como Cliente *@
@* @using Microsoft.AspNetCore.Authorization *@
@* @attribute [Authorize(Roles = "Cliente")] *@

<PageTitle>Comprar Libros</PageTitle>

@* 2. MARKUP HTML CON BOOTSTRAP Y RAZOR *@
<div class="container">

    @* Cabecera *@
    <h3>Seleccionar libros para comprar</h3>

    @* Filtros (Género y Precio) *@
    <div class="row mb-3">
        <div class="col-md-4">
            <input type="text" class="form-control"
                   placeholder="Filtrar por género..."
                   @bind="filtroGenero" id="inputGenero" />
        </div>

        <div class="col-md-4">
            <input type="number" class="form-control"
                   placeholder="Precio máximo..."
                   min="0" step="0.01"
                   @bind="filtroPrecio" id="inputPrecio" />
        </div>

        <div class="col-md-4">
            <button class="btn btn-primary"
                    @onclick="SearchLibros"
                    disabled="@cargando"
                    id="searchLibros">
                Buscar
            </button>
        </div>
    </div>

    @* Aviso de error si falla la API *@
    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger">@errorMessage</div>
    }

    @* Resultados y carrito de compra *@
    <div class="row">

        @* Listado de libros disponibles *@
        <div class="col-md-8">

            @if (cargando)
            {
                <p>Cargando libros...</p>
            }
            else if (libros == null || !libros.Any())
            {
                @if (string.IsNullOrEmpty(errorMessage))
                {
                    <p>No hay libros disponibles para comprar con esos filtros.</p>
                }
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover" id="TableOfLibros">
                        <thead>
                            <tr>
                                <th>Título</th>
                                <th>Género</th>
                                <th>Editorial</th>
                                <th>Fecha Lanzamiento</th>
                                <th>Precio Compra</th>
                                <th>Acción</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var libro in libros)
                            {
                                <tr>
                                    <td>@libro.Titulo</td>
                                    <td>@libro.Genero</td>
                                    <td>@libro.Editorial</td>
                                    <td>@libro.FechaLanzamiento.DateTime.ToShortDateString()</td>
                                    <td>@libro.PrecioCompra.ToString("N2") €</td>
                                    <td>
                                        <button class="btn btn-outline-primary btn-sm"
                                                id="libroToComprar_@libro.Id"
                                                disabled="@compraState.ContieneLibro(libro.Id)"
                                                @onclick="() => AddLibro(libro)">
                                            @(compraState.ContieneLibro(libro.Id) ? "Añadido" : "Añadir")
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

        @* Carrito de compra *@
        <div class="col-md-4">
            <div class="card">
                <div class="card-body">

                    <h5 class="card-title">Carrito de compra</h5>

                    @if (!compraState.LibrosCarrito.Any())
                    {
                        <p class="text-muted">No hay libros seleccionados.</p>
                    }
                    else
                    {
                        <ul class="list-group list-group-flush mb-3">
                            @foreach (var libro in compraState.LibrosCarrito)
                            {
                                <li class="list-group-item">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <div>
                                            <strong>@libro.Titulo</strong>
                                            <p class="mb-0">
                                                @libro.PrecioCompra.ToString("N2") €
                                            </p>
                                        </div>

                                        <button class="btn btn-outline-danger btn-sm"
                                                id="libroSeleccionado_@libro.Id"
                                                @onclick="() => RemoveLibro(libro.Id)">
                                            Eliminar
                                        </button>
                                    </div>
                                </li>
                            }
                        </ul>
                    }

                    <hr />

                    @* Precio total del carrito *@
                    <h5>
                        Precio total: @compraState.PrecioTotal.ToString("N2") €
                    </h5>

                    @* Botón para continuar con la compra *@
                    <button class="btn btn-primary w-100 mt-3"
                            id="comprarLibros"
                            disabled="@(compraState.LibrosCarrito.Count == 0)"
                            @onclick="ComprarLibros">
                        Comprar libro
                    </button>

                </div>
            </div>
        </div>
    </div>
</div>

@* 3. LÓGICA C# *@
@code {
    private ICollection<LibroParaComprarDTO>? libros;
    private string? filtroGenero;
    private double? filtroPrecio;
    private string errorMessage = "";
    private bool cargando = true;

    // Se ejecuta automáticamente al cargar la página
    protected override async Task OnInitializedAsync()
    {
        await SearchLibros();
    }

    // Busca los libros disponibles aplicando los filtros
    private async Task SearchLibros()
    {
        errorMessage = "";

        // Comprobamos que el precio no sea negativo
        if (filtroPrecio.HasValue && filtroPrecio.Value < 0)
        {
            errorMessage = "El precio máximo no puede ser negativo.";
            return;
        }

        cargando = true;

        try
        {
            // Si el género está vacío, enviamos null
            string? genero = string.IsNullOrWhiteSpace(filtroGenero)
                ? null : filtroGenero.Trim();

            // Si el precio está vacío, enviamos null
            libros = await apiservice.GetLibrosParaComprarAsync(
                genero, filtroPrecio);
        }
        catch (ApiException)
        {
            errorMessage = "Error al conectar con la API para cargar los libros.";
            libros = new List<LibroParaComprarDTO>();
        }
        catch (HttpRequestException)
        {
            errorMessage = "No se ha podido establecer conexión con la API.";
            libros = new List<LibroParaComprarDTO>();
        }
        finally
        {
            cargando = false;
        }
    }

    // Añade un libro al carrito de compra
    private void AddLibro(LibroParaComprarDTO libro)
    {
        compraState.AddLibroToCompra(libro);
    }

    // Elimina un libro del carrito de compra
    private void RemoveLibro(int libroId)
    {
        compraState.RemoveLibroFromCompra(libroId);
    }

    // Continúa con el proceso de compra
    private void ComprarLibros()
    {
        if (compraState.LibrosCarrito.Any())
        {
            navigation.NavigateTo("/compras/createcompra");
        }
    }
}
